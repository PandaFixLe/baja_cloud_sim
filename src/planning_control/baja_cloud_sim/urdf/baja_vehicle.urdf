<?xml version="1.0"?>
<robot name="baja_vehicle">
  <material name="body"><color rgba="0.04 0.48 0.62 1"/></material><material name="tire"><color rgba="0.035 0.035 0.035 1"/></material>
  <link name="base_link"><visual><origin xyz="0 0 0"/><geometry><box size="2.8 1.34 0.34"/></geometry><material name="body"/></visual></link>
  <link name="rear_left_wheel"><visual><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.279" length="0.18"/></geometry><material name="tire"/></visual></link>
  <link name="rear_right_wheel"><visual><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.279" length="0.18"/></geometry><material name="tire"/></visual></link>
  <link name="front_left_steering"/><link name="front_right_steering"/>
  <link name="front_left_wheel"><visual><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.279" length="0.18"/></geometry><material name="tire"/></visual></link>
  <link name="front_right_wheel"><visual><origin rpy="1.570796 0 0"/><geometry><cylinder radius="0.279" length="0.18"/></geometry><material name="tire"/></visual></link>
  <joint name="rear_left_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_left_wheel"/><origin xyz="-0.715 0.745 -0.178"/><axis xyz="0 1 0"/></joint>
  <joint name="rear_right_wheel_joint" type="continuous"><parent link="base_link"/><child link="rear_right_wheel"/><origin xyz="-0.715 -0.745 -0.178"/><axis xyz="0 1 0"/></joint>
  <joint name="front_left_steering_joint" type="revolute"><parent link="base_link"/><child link="front_left_steering"/><origin xyz="0.715 0.655 -0.178"/><axis xyz="0 0 1"/><limit lower="-0.7" upper="0.7" effort="180" velocity="2.5"/></joint>
  <joint name="front_right_steering_joint" type="revolute"><parent link="base_link"/><child link="front_right_steering"/><origin xyz="0.715 -0.655 -0.178"/><axis xyz="0 0 1"/><limit lower="-0.7" upper="0.7" effort="180" velocity="2.5"/></joint>
  <joint name="front_left_wheel_joint" type="continuous"><parent link="front_left_steering"/><child link="front_left_wheel"/><origin xyz="0 0.09 0"/><axis xyz="0 1 0"/></joint>
  <joint name="front_right_wheel_joint" type="continuous"><parent link="front_right_steering"/><child link="front_right_wheel"/><origin xyz="0 -0.09 0"/><axis xyz="0 1 0"/></joint>
</robot>
