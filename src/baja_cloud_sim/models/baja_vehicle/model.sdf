<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.9">
  <model name="baja_vehicle">
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>256.0</mass>
        <pose>-0.08 0 0 0 0 0</pose>
        <inertia>
          <ixx>54.65</ixx>
          <iyy>155.53</iyy>
          <izz>182.40</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box>
            <size>2.80 1.34 0.34</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>800000</kp>
              <kd>200</kd>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box>
            <size>2.80 1.34 0.34</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.20 0.28 1</ambient>
          <diffuse>0.04 0.48 0.62 1</diffuse>
          <pbr><metal><roughness>0.42</roughness><metalness>0.18</metalness></metal></pbr>
        </material>
      </visual>
      <visual name="nose_visual">
        <pose>1.22 0 0.15 0 0 0</pose>
        <geometry>
          <box>
            <size>0.36 1.18 0.22</size>
          </box>
        </geometry>
        <material>
          <ambient>0.95 0.42 0.06 1</ambient>
          <diffuse>1.0 0.58 0.08 1</diffuse>
        </material>
      </visual>
      <sensor name="recording_camera" type="camera">
        <pose>-5.0 0 3.0 0 0.48 0</pose>
        <topic>/simulation/recording_camera/image</topic>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.25</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.15</near>
            <far>180.0</far>
          </clip>
        </camera>
      </sensor>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.715 0.745 -0.178 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.183</ixx>
          <iyy>0.341</iyy>
          <izz>0.183</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="tire">
        <pose>0 0 0 1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.292</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.35</mu>
              <mu2>1.05</mu2>
              <fdir1>1 0 0</fdir1>
            </ode>
          </friction>
          <contact>
