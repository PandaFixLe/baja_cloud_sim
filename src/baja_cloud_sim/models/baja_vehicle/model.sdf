      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.183</ixx>
          <iyy>0.341</iyy>
          <izz>0.183</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
