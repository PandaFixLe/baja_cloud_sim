        </material>
      </visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.12</damping>
          <friction>0.04</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.12</damping>
          <friction>0.04</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="front_left_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_left_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.70</lower>
          <upper>0.70</upper>
          <effort>180</effort>
          <velocity>2.5</velocity>
        </limit>
        <dynamics>
          <damping>7.0</damping>
          <friction>0.6</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="front_right_steering_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_steering</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.70</lower>
          <upper>0.70</upper>
          <effort>180</effort>
          <velocity>2.5</velocity>
        </limit>
        <dynamics>
          <damping>7.0</damping>
          <friction>0.6</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steering</parent>
      <child>front_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.08</damping>
          <friction>0.03</friction>
        </dynamics>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steering</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.08</damping>
          <friction>0.03</friction>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <wheel_separation>1.49</wheel_separation>
      <kingpin_width>1.31</kingpin_width>
      <wheel_base>1.43</wheel_base>
      <wheel_radius>0.292</wheel_radius>
      <steering_limit>0.610865</steering_limit>
      <steer_p_gain>18.0</steer_p_gain>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>5.0</max_velocity>
      <min_acceleration>-4.0</min_acceleration>
      <max_acceleration>2.4</max_acceleration>
      <min_jerk>-8.0</min_jerk>
      <max_jerk>6.0</max_jerk>
      <topic>/model/baja_vehicle/cmd_vel</topic>
      <odom_topic>/model/baja_vehicle/wheel_odometry</odom_topic>
      <tf_topic>/model/baja_vehicle/wheel_tf</tf_topic>
      <frame_id>map</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/baja_vehicle/ground_truth_odometry</odom_topic>
      <odom_covariance_topic>/model/baja_vehicle/ground_truth_odometry_with_covariance</odom_covariance_topic>
      <tf_topic>/model/baja_vehicle/ground_truth_tf</tf_topic>
      <dimensions>3</dimensions>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/baja_vehicle/joint_state</topic>
    </plugin>
  </model>
</sdf>
